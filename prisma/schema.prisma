generator client {
  provider      = "prisma-client"
  output        = "../prisma/generated/prisma"
  compilerBuild = "fast"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  admin
  user
}

enum EmployeeStatus {
  active
  inactive
  onLeave
}

enum ExpenseStatus {
  pending
  approved
  rejected
}

enum BillType {
  monthly
  quarterly
  yearly
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  username  String
  employees Employee[]
  admin     Admin[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([username])
  @@index([email])
}

model Employee {
  id         String         @id @default(uuid())
  firstName  String
  lastName   String
  phone      String
  jobTitle   String
  department String
  startDate  String
  currency   String
  role       UserRole
  status     EmployeeStatus
  street     String
  city       String
  state      String
  zipCode    String
  salary     Float
  expenses   Expense[]

  user   User   @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, id])
  @@index([userId])
}

model Admin {
  id         String         @id @default(uuid())
  firstName  String
  lastName   String
  phone      String
  jobTitle   String
  department String
  startDate  String
  currency   String
  role       UserRole
  salary     Float
  status     EmployeeStatus
  street     String
  city       String
  state      String
  zipCode    String
  expenses   Expense[]
  bills      Bill[]

  user   User   @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, id])
  @@index([userId])
}

model Expense {
  id           String        @id @default(uuid())
  date         String
  category     String
  amount       Float
  currency     String
  merchantName String
  description  String?
  employeeName String?
  status       ExpenseStatus @default(pending)
  receiptUrl   String?

  admin   Admin  @relation(fields: [adminId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  adminId String

  employee   Employee @relation(fields: [employeeId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  employeeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, employeeId, id])
  @@index([adminId, employeeId])
}

model Bill {
  id              String   @id @default(uuid())
  title           String
  amount          Float
  category        String
  dueDate         String
  isRecurring     Boolean
  recurringType   BillType
  reminderDays    Int
  isPaid          Boolean
  paidDate        String?
  receiptImage    String?
  reminderEnabled Boolean
  currency        String?

  admin   Admin  @relation(fields: [adminId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  adminId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, id])
  @@index([adminId])
}
