{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "prisma generate && prisma migrate deploy && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "prisma generate && nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "prepare": "husky",
    "report": "bash ./scripts/generate_report.sh",
    "test": "echo \"No tests yet\" && exit 0",
    "db:reset": "prisma migrate reset && prisma db seed",
    "db:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@adonisjs/hash": "9.1.1",
    "@nuxt/eslint": "1.10.0",
    "@nuxt/ui": "^4.0.1",
    "@nuxt/ui-pro": "^3.3.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.4.1",
    "@types/node": "^25.3.1",
    "@vercel/blob": "^2.8.2",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.1",
    "ioredis": "^5.11.1",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.29",
    "openai": "^7.4.0",
    "pg": "^8.23.1",
    "prisma": "^7.4.1",
    "uuid": "^13.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "^3.5.22",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.94",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "husky": "^9.1.7",
    "oxc-parser": "^0.151.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@10.13.1"
