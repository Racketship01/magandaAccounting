# @nuxt/ui-pro license key (required at build time)
NUXT_UI_PRO_LICENSE=

# PostgreSQL — in production point DATABASE_URL at a POOLED endpoint.
# DIRECT_URL should be the direct (non-pooled) connection used for migrations.
DATABASE_URL="postgres://user:password@host:5432/db?sslmode=require"
DIRECT_URL="postgres://user:password@host:5432/db?sslmode=require"

# Max connections per serverless instance's Prisma pool (default: 5)
DATABASE_POOL_MAX=5

# nuxt-auth-utils session encryption key — must be 32+ chars and unique per env
NUXT_SESSION_PASSWORD=

# Vercel Blob read/write token (avatar & receipt uploads)
BLOB_READ_WRITE_TOKEN=

# Redis (Upstash or compatible) for cross-instance notification fan-out
REDIS_URL=

# OpenAI API key (receipt OCR / scanning)
OPENAI_API_KEY=
