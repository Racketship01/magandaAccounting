{
  "version": 3,
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_fonts/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_fonts(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "/test",
      "dest": "/test"
    },
    {
      "src": "/signup",
      "dest": "/signup"
    },
    {
      "src": "/receipt",
      "dest": "/receipt"
    },
    {
      "src": "/profile",
      "dest": "/profile"
    },
    {
      "src": "/login",
      "dest": "/login"
    },
    {
      "src": "/expense",
      "dest": "/expense"
    },
    {
      "src": "/employee",
      "dest": "/employee"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard"
    },
    {
      "src": "/bills",
      "dest": "/bills"
    },
    {
      "src": "/api/updateProfile",
      "dest": "/api/updateProfile"
    },
    {
      "src": "/api/notifications/stream",
      "dest": "/api/notifications/stream"
    },
    {
      "src": "/api/notifications/read-all",
      "dest": "/api/notifications/read-all"
    },
    {
      "src": "/api/notifications",
      "dest": "/api/notifications"
    },
    {
      "src": "/api/jobs/billDueReminders",
      "dest": "/api/jobs/billDueReminders"
    },
    {
      "src": "/api/getCurrentUser",
      "dest": "/api/getCurrentUser"
    },
    {
      "src": "/api/getBills",
      "dest": "/api/getBills"
    },
    {
      "src": "/api/getAllEmployee",
      "dest": "/api/getAllEmployee"
    },
    {
      "src": "/api/expense/scan",
      "dest": "/api/expense/scan"
    },
    {
      "src": "/api/expense/getAllExpense",
      "dest": "/api/expense/getAllExpense"
    },
    {
      "src": "/api/expense/createExpense",
      "dest": "/api/expense/createExpense"
    },
    {
      "src": "/api/dashboard/getStats",
      "dest": "/api/dashboard/getStats"
    },
    {
      "src": "/api/createEmployeeUser",
      "dest": "/api/createEmployeeUser"
    },
    {
      "src": "/api/createBill",
      "dest": "/api/createBill"
    },
    {
      "src": "/api/blob/upload",
      "dest": "/api/blob/upload"
    },
    {
      "src": "/api/auth/test",
      "dest": "/api/auth/test"
    },
    {
      "src": "/api/auth/signup",
      "dest": "/api/auth/signup"
    },
    {
      "src": "/api/auth/login",
      "dest": "/api/auth/login"
    },
    {
      "src": "/api/_auth/session",
      "dest": "/api/_auth/session"
    },
    {
      "src": "/__nuxt_error",
      "dest": "/__nuxt_error"
    },
    {
      "src": "/",
      "dest": "/index"
    },
    {
      "src": "/api/updateExpense/(?<idExpense>[^/]+)",
      "dest": "/api/updateExpense/[idExpense]"
    },
    {
      "src": "/api/updateEmployee/(?<id>[^/]+)",
      "dest": "/api/updateEmployee/[id]"
    },
    {
      "src": "/api/updateBill/(?<idBill>[^/]+)",
      "dest": "/api/updateBill/[idBill]"
    },
    {
      "src": "/api/notifications/(?<id>[^/]+)/read",
      "dest": "/api/notifications/[id]/read"
    },
    {
      "src": "/api/notifications/(?<id>[^/]+)/deleteNotification",
      "dest": "/api/notifications/[id]/deleteNotification"
    },
    {
      "src": "/api/deleteExpense/(?<idExpense>[^/]+)",
      "dest": "/api/deleteExpense/[idExpense]"
    },
    {
      "src": "/api/deleteEmployee/(?<id>[^/]+)",
      "dest": "/api/deleteEmployee/[id]"
    },
    {
      "src": "/api/deleteBill/(?<idBill>[^/]+)",
      "dest": "/api/deleteBill/[idBill]"
    },
    {
      "src": "/api/_nuxt_icon/(?<collection>[^/]+)",
      "dest": "/api/_nuxt_icon/[collection]"
    },
    {
      "src": "/__nuxt_island/(?:.*)",
      "dest": "/__nuxt_island/[...]"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
}